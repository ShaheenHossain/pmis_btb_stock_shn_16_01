<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="btb_print_stock_report" model="ir.actions.report">
        <field name="name">Stock Report</field>
        <field name="model">btb.stock.report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">btb_stock.stock_report</field>
        <!--        <field name="report_file">hr.print_person_badge</field>-->
        <!--        <field name="print_report_name">'Print Badge - %s' % (object.name).replace('/', '')</field>-->
        <field name="binding_model_id" ref="model_btb_stock_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="btb_stock_report_form" model="ir.ui.view">
        <field name="name">btb.stock.report</field>
        <field name="model">btb.stock.report</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Stock Ledger Report</h1>
                        <p class="text-muted">Print a movement history for one, several, or all products over a date range.</p>
                    </div>
                    <group>
                        <field name="product_ids" widget="many2many_tags" placeholder="Select product/Products. Keep blank for all products"/>
                        <group>
                            <field name="from_date" required="True"/>
                            <field name="till_date" required="True"/>
                        </group>
                        <group>
                            <field name="report_for"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="%(btb_print_stock_report)d" string="Print Report" type="action" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <template id="stock_report">

        <t t-call="web.html_container">
            <t t-call="btb_layout.external_layout_btb">
                <style>
                    .btb-ledger {
                        font-family: 'Helvetica Neue', Arial, sans-serif;
                        color: #1f2d3d;
                        font-size: 11.5px;
                    }
                    .btb-ledger .btb-ledger-header {
                        border-bottom: 3px solid #0b3d59;
                        padding-bottom: 8px;
                        margin-bottom: 12px;
                    }
                    .btb-ledger .btb-ledger-header .btb-doctype {
                        font-size: 10px;
                        letter-spacing: 1.5px;
                        text-transform: uppercase;
                        color: #7a8894;
                    }
                    .btb-ledger .btb-ledger-header h2 {
                        font-size: 18px;
                        font-weight: 700;
                        color: #0b3d59;
                        margin: 0;
                    }
                    .btb-ledger .btb-ledger-header .btb-range {
                        text-align: right;
                        font-size: 11px;
                        color: #45525e;
                    }
                    .btb-ledger .btb-product-block {
                        page-break-inside: avoid;
                        margin-bottom: 16px;
                    }
                    .btb-ledger .btb-product-title {
                        background-color: #0b3d59;
                        color: #ffffff;
                        padding: 6px 10px;
                        font-size: 12px;
                        font-weight: 700;
                        border-radius: 3px 3px 0 0;
                    }
                    .btb-ledger .btb-product-title .btb-product-sl {
                        display: inline-block;
                        min-width: 16px;
                        margin-right: 4px;
                        color: #cfe0ea;
                    }
                    .btb-ledger table.btb-move-table {
                        width: 100%;
                        border-collapse: collapse;
                    }
                    .btb-ledger table.btb-move-table thead th {
                        background-color: #e9edf1;
                        color: #33414d;
                        font-size: 9.5px;
                        text-transform: uppercase;
                        letter-spacing: .3px;
                        padding: 5px 6px;
                        border: 1px solid #dfe3e8;
                        text-align: left;
                    }
                    .btb-ledger table.btb-move-table tbody td {
                        padding: 4px 6px;
                        border: 1px solid #dfe3e8;
                        font-size: 11px;
                    }
                    .btb-ledger table.btb-move-table tbody tr:nth-child(even) {
                        background-color: #f8f9fa;
                    }
                    .btb-ledger table.btb-move-table .btb-num { text-align: right; }
                    .btb-ledger table.btb-move-table .btb-no-trans {
                        text-align: center;
                        color: #7a8894;
                        font-style: italic;
                        padding: 10px;
                    }
                </style>
                <div class="page btb-ledger">
                    <t t-set="company" t-value="env.company"/>
                    <t t-foreach="docs" t-as="doc">
                        <div class="btb-ledger-header">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="width:65%;">
                                        <div class="btb-doctype">Inventory / Stock Ledger</div>
                                        <h2>Stock Movement Report</h2>
                                    </td>
                                    <td style="width:35%;" class="btb-range">
                                        Period: <t t-esc="doc.from_date.strftime('%d %b %Y')"/> &#8211; <t t-esc="doc.till_date.strftime('%d %b %Y')"/>
                                        <br/>
                                        Printed on: <t t-esc="datetime.date.today().strftime('%d %B %Y')"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <t t-set="products" t-value="doc.get_products()"/>
                        <t t-set="product_sl" t-value="0"/>
                        <t t-foreach="products" t-as="product">
                            <t t-set="product_sl" t-value="product_sl+1"/>
                            <div class="btb-product-block">
                                <div class="btb-product-title">
                                    <span class="btb-product-sl"><t t-esc="product_sl"/>.</span>
                                    <t t-esc="product.name"/>
                                </div>
                                <table class="btb-move-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th class="btb-num">Received</th>
                                            <th class="btb-num">Previous</th>
                                            <th class="btb-num">Distributed</th>
                                            <th class="btb-num">Remaining</th>
                                            <th>Comment</th>
                                            <th>Number</th>
                                            <th>Req. By</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="moves" t-value="doc.stock_move_history(product)"/>
                                        <t t-foreach="moves" t-as="move">
                                            <t t-if="move_first">
                                                <t t-set="opening_stock"
                                                   t-value="doc.get_opening_stock(move.product_id, move.date - datetime.timedelta(days=1))"/>
                                            </t>
                                            <t t-else="">
                                                <t t-set="opening_stock" t-value="remind"/>
                                            </t>
                                            <t t-set="remind" t-value="0"/>
                                            <t t-set="type" t-value="move.move_id.location_id.name"/>
                                            <tr>
                                                <td><t t-esc="move.date.strftime('%d/%m/%Y')"/></td>
                                                <td class="btb-num">
                                                    <t t-if="type!='Stock'">
                                                        <t t-set="remind" t-value="opening_stock+move.qty_done"/>
                                                        <t t-esc="move.qty_done"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-set="remind" t-value="opening_stock-move.qty_done"/>
                                                    </t>
                                                </td>
                                                <td class="btb-num"><t t-esc="opening_stock"/></td>
                                                <td class="btb-num">
                                                    <t t-if="type=='Stock'">
                                                        <t t-esc="move.qty_done"/>
                                                    </t>
                                                </td>
                                                <td class="btb-num"><t t-esc="remind"/></td>
                                                <td><t t-esc="doc.get_comment(move)"/></td>
                                                <td><t t-esc="move.origin"/></td>
                                                <td><t t-esc="move.env['sale.order'].search([('name','=',move.origin)]).partner_id.name"/></td>
                                            </tr>
                                        </t>

                                        <t t-if="len(moves)==0">
                                            <t t-set="opening_stock" t-value="doc.get_opening_stock(product, doc.till_date)"/>
                                            <tr>
                                                <td><t t-esc="doc.till_date.strftime('%d %B %Y')"/></td>
                                                <td class="btb-num"></td>
                                                <td class="btb-num"><t t-esc="opening_stock"/></td>
                                                <td class="btb-num"></td>
                                                <td class="btb-num"><t t-esc="opening_stock"/></td>
                                                <td colspan="4" class="btb-no-trans">No transaction in this period</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="btb_stock_report_form_action" model="ir.actions.act_window">
            <field name="name">stock.report.form.action</field>
            <field name="res_model">btb.stock.report</field>
            <field name="view_mode">form</field>
<!--            <field name="context">{'from_my_profile': True}</field>-->

        </record>


</odoo>
